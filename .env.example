# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。

# ── 数据路径 ────────────────────────────────────────────────
NEW_DATA_DIR = "./new_Data"
FIN_DB_PATH = "./db/financial.db"
REPORT_YEAR = 2025

# ── 向量库 ──────────────────────────────────────────────────
# Lite 模式（零依赖）："./db/milvus.db"
# standalone 模式：     "http://127.0.0.1:19530"
MILVUS_ENDPOINT = "./db/milvus.db"
MILVUS_COLLECTION = "fin_report_chunks"

# ── 生成模型 ────────────────────────────────────────────────
# dashscope（云端）| ollama（本地）
LLM_PROVIDER = "dashscope"
LLM_MODEL_NAME = "qwen-plus"
LLM_TEMPERATURE = 0
LLM_NUM_CTX = 16384

DASHSCOPE_API_KEY = ""
DASHSCOPE_MODEL = "qwen3.8-max-0902"

# ── 意图识别（本地小模型）───────────────────────────────────
OLLAMA_MODEL_NAME = "rllm-finqa-4b:q4"
OLLAMA_BASE_URL = "http://127.0.0.1:11434"
# llm=模型提议+代码裁决；rule=纯规则兜底（不需要本地模型）
INTENT_MODE = "llm"
INTENT_TIMEOUT = 30

# ── 鉴权 ────────────────────────────────────────────────────
SECRET_KEY = "change-me-to-a-random-string"
ALGORITHM = "HS256"
ACCESS_TOKEN_EXPIRE_MINUTES = 30